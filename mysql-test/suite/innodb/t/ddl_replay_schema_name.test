--source include/have_debug_sync.inc

--disable_query_log
CALL mtr.add_suppression("Failed to set extended attribute");
--enable_query_log

--disable_warnings
DROP DATABASE IF EXISTS `mtr-ddl-rollback`;
--enable_warnings
# The hyphen is escaped in the schema directory name used by InnoDB.
CREATE DATABASE `mtr-ddl-rollback`;
USE `mtr-ddl-rollback`;
CREATE TABLE t (id INT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO t VALUES (1);
CREATE VIEW v AS SELECT id FROM t;

# Interrupt the ALTER after the InnoDB rebuild, causing DDL rollback.
--connect (ddl, localhost, root,,)
USE `mtr-ddl-rollback`;
--let $ddl_id= `SELECT CONNECTION_ID()`
SET DEBUG_SYNC = 'alter_table_inplace_will_need_reset SIGNAL ddl_ready WAIT_FOR ddl_killed';
--send ALTER TABLE t ENGINE=InnoDB, ALGORITHM=INPLACE

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR ddl_ready';
--replace_result $ddl_id DDL_ID
--eval KILL QUERY $ddl_id
SET DEBUG_SYNC = 'now SIGNAL ddl_killed';

--connection ddl
--error ER_QUERY_INTERRUPTED
--reap
--disconnect ddl

--connection default
SET DEBUG_SYNC = 'RESET';
SELECT * FROM `mtr-ddl-rollback`.t;
INSERT INTO `mtr-ddl-rollback`.t VALUES (2);
ALTER TABLE `mtr-ddl-rollback`.t ADD COLUMN c INT NULL, ALGORITHM=INSTANT;
SELECT * FROM `mtr-ddl-rollback`.t ORDER BY id;
DROP VIEW `mtr-ddl-rollback`.v;
DROP DATABASE `mtr-ddl-rollback`;
